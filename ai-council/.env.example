# --- Slack (required) ---
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# Channel IDs where every message triggers the council (comma separated).
# Leave empty to respond only to DMs and @mentions.
COUNCIL_CHANNEL_IDS=

# Only these Slack user IDs can trigger the bot (strongly recommended).
ALLOWED_USER_IDS=

# --- Council ---
# Members to use: claude, gpt, gemini (default: all three)
COUNCIL_MEMBERS=claude,gpt,gemini
# Member that writes the final synthesis
COUNCIL_CHAIR=claude
# true = add anonymized cross-review stage (slower, ~2x calls)
COUNCIL_REVIEW=false
ANSWER_LANGUAGE=Korean

# --- CLI ---
CLI_TIMEOUT_SEC=300
MAX_CONTEXT_CHARS=30000
# Override if a CLI is not on PATH, e.g. C:\Users\me\AppData\Roaming\npm\codex.cmd
CLAUDE_BIN=claude
CODEX_BIN=codex
GEMINI_BIN=gemini
